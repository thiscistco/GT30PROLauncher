<?xml version="1.0" encoding="utf-8"?>
<!-- Homescreen minimalis: hanya wallpaper, sesuai preview (tanpa ikon/dock/widget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <com.gt30pro.launcher.CircuitGlowView
        android:id="@+id/amber_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:clickable="false" />

    <!-- Lapisan kaca layar hanya untuk homescreen; tidak menangkap sentuhan. -->
    <ImageView
        android:id="@+id/screen_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false"
        android:scaleType="fitXY" />

</FrameLayout>
